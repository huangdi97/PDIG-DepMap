<template>
  <scroll-view class="page" scroll-y>
    <view class="intro">
      <text class="intro-title">影响模拟</text>
      <text class="intro-sub">假设一张卡不能用了，看看哪些服务会受影响。这只是推演，不会修改任何数据。</text>
    </view>

    <dp-card title="选择要停用的支付工具">
      <dp-state
        v-if="loading"
        kind="loading"
        title="正在读取…"
      />
      <dp-state
        v-else-if="cards.length === 0"
        kind="empty"
        title="还没有支付工具"
        description="先到「支付 · 账户 · 服务」里添加一张银行卡或支付账户。"
        action-label="去添加"
        @action="goNodes"
      />
      <view v-else>
        <dp-row
          v-for="(n, i) in cards"
          :key="n.id"
          :title="n.name"
          description="点击选择要停用的支付工具"
          :value="n.id === selected ? '已选择' : ''"
          :value-tone="n.id === selected ? 'success' : 'neutral'"
          :last="i === cards.length - 1"
          @tap="select(n.id)"
        />
      </view>
    </dp-card>

    <dp-card title="下一步">
      <dp-button label="查看影响清单" :disabled="selected === ''" @tap="run" block />
    </dp-card>
  </scroll-view>
</template>

<script lang="uts">
import { listPaymentInstruments } from '../../services/depmap-service'

interface NodeRow {
  id: string
  name: string
  kind: string
  issuer: string
  last4: string
}

export default {
  data() {
    return {
      loading: true,
      selected: '',
      cards: [] as NodeRow[]
    }
  },
  onShow() {
    this.load()
  },
  methods: {
    load() {
      this.loading = true
      listPaymentInstruments()
        .then((rows) => {
          this.cards = rows as NodeRow[]
          this.loading = false
        })
        .catch((_e) => {
          this.loading = false
        })
    },
    goNodes() {
      uni.navigateTo({ url: '/pages/nodes/nodes' })
    },
    select(id: string) {
      this.selected = id
    },
    run() {
      if (this.selected === '') {
        uni.showToast({ title: '先选择一张卡', icon: 'none' })
        return
      }
      uni.navigateTo({ url: `/pages/simulate/impact-result?nodeId=${this.selected}` })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.intro { padding: 20px 16px 0 16px; }
.intro-title { font-size: 22px; font-weight: bold; color: #1B1D29; }
.intro-sub { margin-top: 6px; font-size: 13px; color: #8A90A6; }
</style>
