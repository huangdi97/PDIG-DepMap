<template>
  <scroll-view class="page" scroll-y>
    <dp-card title="影响清单">
      <text class="lead">结果只基于你已经确认过的支付关系。系统推断出的关系不参与这里。</text>
      <dp-state
        v-if="loading"
        kind="loading"
        title="正在推演…"
      />
      <dp-state
        v-else-if="items.length === 0"
        kind="empty"
        title="没有找到已确认的受影响关系"
        description="可能还没有确认过相关的支付关系，或这张卡没有被确认的依赖。"
      />
    </dp-card>

    <dp-card v-for="(item, idx) in items" :key="idx" :title="levelLabel(item.level)">
      <text class="line">{{ item.title }}</text>
      <text class="quiet">{{ item.detail }}</text>
    </dp-card>

    <dp-card title="最后一步">
      <text class="quiet">处理完以上事项后，再执行真实的注销或停用操作。本应用不会替你执行任何真实操作。</text>
    </dp-card>
  </scroll-view>
</template>

<script lang="uts">
import { simulateUnavailable } from '../../services/depmap-service'

interface ImpactRow {
  title: string
  level: string
  detail: string
}

export default {
  data() {
    return {
      loading: true,
      nodeId: '',
      items: [] as ImpactRow[]
    }
  },
  onLoad(options: OnLoadOptions) {
    this.nodeId = options['nodeId'] ?? ''
  },
  onShow() {
    this.load()
  },
  methods: {
    levelLabel(level: string): string {
      if (level === 'must_change') return '必须处理'
      if (level === 'needs_review') return '建议检查'
      return '不受影响'
    },
    load() {
      this.loading = true
      simulateUnavailable(this.nodeId)
        .then((rows) => {
          this.items = rows as ImpactRow[]
          this.loading = false
        })
        .catch((_e) => {
          this.loading = false
        })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.lead { font-size: 13px; color: #8A90A6; }
.line { font-size: 15px; color: #1B1D29; }
.quiet { margin-top: 6px; font-size: 13px; color: #8A90A6; }
</style>
