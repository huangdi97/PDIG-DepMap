<template>
  <scroll-view class="page" scroll-y>
    <dp-card title="支付 · 账户 · 服务">
      <dp-state
        v-if="loading"
        kind="loading"
        title="正在读取…"
      />
      <dp-state
        v-else-if="nodes.length === 0"
        kind="empty"
        title="还没有建立依赖关系"
        description="在下面添加一个对象（银行卡 / 服务），再到它的详情页声明支付关系。"
      />
      <view v-else>
        <dp-row
          v-for="(node, i) in nodes"
          :key="node.id"
          :title="node.name"
          :description="subtitleOf(node)"
          :value="kindLabel(node.kind)"
          :last="i === nodes.length - 1"
          @tap="openDetail(node.id)"
        />
      </view>
    </dp-card>

    <dp-card title="添加对象">
      <input class="input" v-model="newName" placeholder="名称（例如：招行经典白）" />
      <picker :range="kindOptions" @change="onKindChange">
        <view class="picker-row">
          <text class="picker-text">类型：{{ kindLabel(newKind) }}</text>
          <text class="quiet">点击切换</text>
        </view>
      </picker>
      <input class="input" v-model="newLast4" placeholder="卡后四位（可选）" />
      <dp-button label="添加" :loading="busy" @tap="createNode" block />
      <text class="quiet">渐进式录入：先填类型和名称，其余信息之后在详情里补充。</text>
    </dp-card>
  </scroll-view>
</template>

<script lang="uts">
import { listNodes, createNode } from '../../services/depmap-service'

interface NodeRow {
  id: string
  name: string
  kind: string
  issuer: string
  last4: string
}

export default {
  data() {
    return {
      loading: true,
      busy: false,
      nodes: [] as NodeRow[],
      newName: '',
      newKind: 'payment_instrument',
      newLast4: '',
      kindOptions: ['银行卡', '支付账户', '服务 / 订阅', '手机号 / 邮箱']
    }
  },
  onShow() {
    this.load()
  },
  methods: {
    kindLabel(kind: string): string {
      if (kind === 'payment_instrument') return '银行卡'
      if (kind === 'account') return '支付账户'
      if (kind === 'service') return '服务 / 订阅'
      if (kind === 'identity_anchor') return '手机号 / 邮箱'
      return kind
    },
    subtitleOf(node: NodeRow): string {
      if (node.issuer === '' && node.last4 === '') return ''
      if (node.last4 === '') return node.issuer
      return node.issuer === '' ? `尾号 ${node.last4}` : `${node.issuer} · 尾号 ${node.last4}`
    },
    load() {
      this.loading = true
      listNodes('')
        .then((rows) => {
          this.nodes = rows as NodeRow[]
          this.loading = false
        })
        .catch((_e) => {
          this.loading = false
        })
    },
    onKindChange(e: PickerChangeEvent) {
      const idx = Number(e.newValue)
      const kinds = ['payment_instrument', 'account', 'service', 'identity_anchor']
      if (idx >= 0 && idx < kinds.length) {
        this.newKind = kinds[idx]
      }
    },
    createNode() {
      const name = this.newName.trim()
      if (name.length === 0) {
        uni.showToast({ title: '请输入名称', icon: 'none' })
        return
      }
      this.busy = true
      createNode(name, this.newKind, this.newLast4.trim())
        .then(() => {
          this.busy = false
          this.newName = ''
          this.newLast4 = ''
          this.load()
        })
        .catch((_e) => {
          this.busy = false
          uni.showToast({ title: '添加失败，请重试', icon: 'none' })
        })
    },
    openDetail(id: string) {
      uni.navigateTo({ url: `/pages/nodes/node-detail?id=${id}` })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.input {
  border-width: 1px;
  border-color: #E6E8F0;
  border-radius: 10px;
  padding: 12px;
  margin: 8px 0;
}
.picker-row {
  flex-direction: row;
  justify-content: space-between;
  min-height: 44px;
  align-items: center;
}
.picker-text { font-size: 15px; color: #1B1D29; }
.quiet { margin-top: 6px; font-size: 13px; color: #8A90A6; }
</style>
