<template>
  <scroll-view class="page" scroll-y>
    <dp-card title="识别到的商户">
      <text class="p">下面这些商户需要你确认对应哪个服务。没有确认过的商户不会生成任何关系建议。</text>
      <dp-state
        v-if="merchants.length === 0"
        kind="empty"
        title="没有待识别的商户"
        description="导入账单后，识别到的商户会显示在这里。"
      />
    </dp-card>

    <dp-card v-for="(m, idx) in merchants" :key="m.merchantRaw" :title="m.merchantRaw">
      <text class="quiet">{{ m.observationCount }} 次观测 · 支付方式：{{ methodsText(m) }}</text>
      <view class="row">
        <view class="cell">
          <dp-button label="创建为服务" @tap="createService(idx)" />
        </view>
        <view class="cell">
          <dp-button label="忽略" variant="secondary" @tap="ignore(idx)" />
        </view>
      </view>
    </dp-card>

    <dp-card v-if="merchants.length > 0" title="下一步">
      <dp-button label="完成并查看建议" @tap="finish" block />
    </dp-card>
  </scroll-view>
</template>

<script lang="uts">
import { appState } from '../../stores/app-state'

interface MerchantRow {
  merchantRaw: string
  observationCount: number
  paymentMethods: string[]
}

export default {
  data() {
    return {
      merchants: [] as MerchantRow[]
    }
  },
  onLoad(_options: OnLoadOptions) {
    this.merchants = appState.pendingMerchants as MerchantRow[]
  },
  methods: {
    methodsText(m: MerchantRow): string {
      return m.paymentMethods.length === 0 ? '未知' : m.paymentMethods.join('、')
    },
    createService(idx: number) {
      const m = this.merchants[idx]
      if (m === undefined) return
      uni.showToast({ title: `已创建：${m.merchantRaw}`, icon: 'none' })
      this.merchants.splice(idx, 1)
    },
    ignore(idx: number) {
      this.merchants.splice(idx, 1)
    },
    finish() {
      uni.navigateTo({ url: '/pages/proposals/proposals' })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.p { margin-top: 4px; font-size: 14px; color: #5A5F73; }
.quiet { font-size: 13px; color: #8A90A6; }
.row { flex-direction: row; margin-top: 12px; }
.cell { flex: 1; margin-right: 8px; }
</style>
