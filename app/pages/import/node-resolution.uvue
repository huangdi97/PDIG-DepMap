<template>
  <scroll-view class="page" scroll-y>
    <view class="card">
      <text class="card-title">识别到的商户</text>
      <text class="hint">以下商户需要你确认对应哪个服务节点。未确认的商户不会生成任何关系建议。</text>
    </view>

    <view class="card" v-for="(m, idx) in merchants" :key="m.merchantRaw">
      <view class="row">
        <text class="node-name">{{ m.merchantRaw }}</text>
        <text class="hint">{{ m.observationCount }} 次观测</text>
      </view>
      <text class="hint">支付方式：{{ m.paymentMethods.join('、') }}</text>
      <view class="resolve-row">
        <view class="btn-primary flex1" @click="createService(idx)"><text class="btn-text">创建为服务节点</text></view>
        <view class="btn-ignore" @click="ignore(idx)"><text>忽略</text></view>
      </view>
    </view>

    <view class="card">
      <view class="btn-primary" @click="finish"><text class="btn-text">完成并生成建议</text></view>
      <text class="hint">完成 = finalize：指纹入库 → 周期识别 → 生成待确认关系</text>
    </view>
  </scroll-view>
</template>

<script lang="uts">
import { appState, type PendingMerchant } from '../../stores/app-state'

export default {
  data() {
    return {
      merchants: [] as PendingMerchant[]
    }
  },
  onLoad(_options: OnLoadOptions) {
    this.merchants = appState.pendingMerchants
  },
  methods: {
    createService(idx: number) {
      const m = this.merchants[idx]
      if (m == null) return
      // 用户确认创建 service 节点（Resolution 顺序 4：用户确认）
      uni.showToast({ title: '已创建：' + m.merchantRaw, icon: 'none' })
      this.merchants.splice(idx, 1)
    },
    ignore(idx: number) {
      this.merchants.splice(idx, 1)
    },
    finish() {
      uni.navigateTo({ url: '/pages/proposals/proposals' })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.row { flex-direction: row; justify-content: space-between; }
.node-name { font-size: 16px; font-weight: bold; }
.resolve-row { flex-direction: row; margin-top: 8px; }
.flex1 { flex: 1; margin-right: 8px; }
.btn-ignore {
  border-width: 1px;
  border-color: #e5e6eb;
  border-radius: 10px;
  padding: 12px 16px;
}
</style>
