<template>
  <scroll-view class="page" scroll-y>
    <view class="intro">
      <text class="intro-title">导入账单</text>
      <text class="intro-sub">支持微信账单 CSV。文件只在本机处理。</text>
    </view>

    <dp-card title="导入前请了解">
      <text class="p">· 文件在本机处理，不会上传到任何服务器。</text>
      <text class="p">· 原始交易记录不会作为长期账本保存。</text>
      <text class="p">· 系统只保留必要的关系证据摘要与你确认的结果。</text>
      <text class="p">· 本应用无账号、无统计、无广告。</text>
    </dp-card>

    <dp-card title="选择文件">
      <dp-button label="选择 CSV 文件" :loading="busy" @tap="chooseFile" block />
      <text class="quiet" v-if="fileName !== ''">已选择：{{ fileName }}</text>
    </dp-card>

    <dp-card title="识别结果">
      <dp-state
        v-if="fileName === ''"
        kind="empty"
        title="还没有选择文件"
        description="选择文件后，这里会显示识别到的商户与服务。"
      />
      <view v-else>
        <text class="p">已就绪，可以开始识别。</text>
        <view class="gap" />
        <dp-button label="开始识别" :loading="busy" @tap="startImport" block />
      </view>
    </dp-card>

    <dp-card title="当前构建说明">
      <text class="p">本机解析模块仍在接入中。在接入完成前，导入流程不会写入任何数据。</text>
      <text class="quiet">已登记为发布阻塞项（App 端解析桥接）。</text>
    </dp-card>
  </scroll-view>
</template>

<script lang="uts">
import { appState } from '../../stores/app-state'

export default {
  data() {
    return {
      busy: false,
      fileName: ''
    }
  },
  methods: {
    chooseFile() {
      uni.chooseFile({
        count: 1,
        extension: ['.csv'],
        success: (res) => {
          if (res.tempFilePaths.length > 0) {
            this.fileName = res.tempFilePaths[0]
          }
        },
        fail: (_e) => {
          uni.showToast({ title: '未选择文件', icon: 'none' })
        }
      } as ChooseFileOptions)
    },
    startImport() {
      if (this.fileName === '') {
        uni.showToast({ title: '请先选择文件', icon: 'none' })
        return
      }
      // 本机解析桥接尚未接入：不写入任何数据，明确告知用户（禁止假功能）。
      appState.pendingMerchants = []
      uni.showToast({ title: '本机解析尚未接入，暂不写入数据', icon: 'none' })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.intro { padding: 20px 16px 0 16px; }
.intro-title { font-size: 22px; font-weight: bold; color: #1B1D29; }
.intro-sub { margin-top: 6px; font-size: 13px; color: #8A90A6; }
.p { margin-top: 4px; font-size: 14px; color: #5A5F73; }
.quiet { margin-top: 8px; font-size: 13px; color: #8A90A6; }
.gap { height: 8px; }
</style>
