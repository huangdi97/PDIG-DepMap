<template>
  <scroll-view class="page" scroll-y>
    <dp-card title="变更计划">
      <dp-state
        v-if="loading"
        kind="loading"
        title="正在读取计划…"
      />
      <dp-state
        v-else-if="errorText !== ''"
        kind="error"
        title="读取失败"
        :description="errorText"
        action-label="重试"
        @action="load"
      />
      <dp-state
        v-else-if="plans.length === 0"
        kind="empty"
        title="还没有变更计划"
        description="从一个实际场景开始，例如「更换银行卡」。"
        action-label="去场景中心"
        @action="goScenarios"
      />
      <view v-else>
        <dp-row
          v-for="(p, i) in plans"
          :key="p.id"
          :title="p.title"
          :description="p.stale ? '需要重新检查（基础设施已变化）' : '分析版本 ' + p.analyzed + ' / 当前 ' + p.current"
          :value="p.stale ? '需重新检查' : workflowLabel(p.workflowState)"
          :value-tone="p.stale ? 'warning' : 'neutral'"
          :last="i === plans.length - 1"
          @tap="open(p.id)"
        />
      </view>
    </dp-card>
  </scroll-view>
</template>

<script lang="uts">
import { listPlans } from '../../services/depmap-service'
import { workflowLabel } from '../../services/rules'

interface PlanRow {
  id: string
  title: string
  workflowState: string
  stale: boolean
  analyzed: number
  current: number
}

export default {
  data() {
    return {
      loading: true,
      errorText: '',
      plans: [] as PlanRow[]
    }
  },
  onShow() {
    this.load()
  },
  methods: {
    workflowLabel(state: string): string {
      return workflowLabel(state)
    },
    load() {
      this.loading = true
      this.errorText = ''
      listPlans()
        .then((rows) => {
          this.plans = rows as PlanRow[]
          this.loading = false
        })
        .catch((_e) => {
          this.loading = false
          this.errorText = '本地数据暂时无法读取。'
        })
    },
    goScenarios() {
      uni.navigateTo({ url: '/pages/scenarios/scenarios' })
    },
    open(id: string) {
      uni.navigateTo({ url: `/pages/plans/plan-detail?id=${id}` })
    }
  }
}
</script>

<style>
.page { flex: 1; }
</style>
