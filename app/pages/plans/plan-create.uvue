<template>
  <scroll-view class="page" scroll-y>
    <view class="intro">
      <text class="intro-title">{{ title }}</text>
      <text class="intro-sub">选择要变更的支付工具。计划创建后会立即做一次基于已确认关系的分析。</text>
    </view>

    <dp-card title="选择支付工具">
      <dp-state
        v-if="loading"
        kind="loading"
        title="正在读取…"
      />
      <dp-state
        v-else-if="instruments.length === 0"
        kind="empty"
        title="还没有支付工具"
        description="先到「支付 · 账户 · 服务」里添加一张银行卡或支付账户。"
        action-label="去添加"
        @action="goNodes"
      />
      <view v-else>
        <dp-row
          v-for="(n, i) in instruments"
          :key="n.id"
          :title="n.name"
          description="选择它作为本次变更的目标"
          :last="i === instruments.length - 1"
          @tap="create(n.id, n.name)"
        />
      </view>
    </dp-card>

    <dp-card title="提前量建议">
      <text class="quiet">{{ leadText }}</text>
    </dp-card>
  </scroll-view>
</template>

<script lang="uts">
import { listPaymentInstruments, createPlanWithAnalysis } from '../../services/depmap-service'
import { findScenario } from '../../services/rules'

interface NodeRow {
  id: string
  name: string
  kind: string
  issuer: string
  last4: string
}

export default {
  data() {
    return {
      loading: true,
      busy: false,
      templateId: 'replace_payment_card',
      title: '',
      leadText: '',
      instruments: [] as NodeRow[]
    }
  },
  onLoad(options: Map<string, string>) {
    this.templateId = options.get('templateId') ?? 'replace_payment_card'
    const sc = findScenario(this.templateId)
    if (sc !== null) {
      this.title = sc.title
      this.leadText = sc.recommendedLeadDays > 0 ? `建议提前 ${sc.recommendedLeadDays} 天开始处理。` : ''
    } else {
      this.title = '更换银行卡'
      this.leadText = ''
    }
  },
  onShow() {
    this.load()
  },
  methods: {
    load() {
      this.loading = true
      listPaymentInstruments()
        .then((rows) => {
          this.instruments = rows as NodeRow[]
          this.loading = false
        })
        .catch((_e) => {
          this.loading = false
        })
    },
    goNodes() {
      uni.navigateTo({ url: '/pages/nodes/nodes' })
    },
    create(nodeId: string, nodeName: string) {
      if (this.busy) return
      this.busy = true
      const planTitle = `${this.title}：${nodeName}`
      createPlanWithAnalysis(this.templateId, nodeId, planTitle, '')
        .then((planId) => {
          this.busy = false
          uni.redirectTo({ url: `/pages/plans/plan-detail?id=${planId}` })
        })
        .catch((_e) => {
          this.busy = false
          uni.showToast({ title: '创建失败，请重试', icon: 'none' })
        })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.intro { padding: 20px 16px 0 16px; }
.intro-title { font-size: 22px; font-weight: bold; color: #1B1D29; }
.intro-sub { margin-top: 6px; font-size: 13px; color: #8A90A6; }
.quiet { font-size: 13px; color: #5A5F73; }
</style>
