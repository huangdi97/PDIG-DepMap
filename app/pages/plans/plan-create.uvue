<template>
  <scroll-view class="root" scroll-y>
    <view class="intro">
      <text class="title">{{ title }}</text>
      <text class="hint">选择要变更的支付工具（目标对象）。计划创建后先做影响分析。</text>
    </view>

    <view class="card" v-for="(node, index) in instruments" :key="index" @click="create(node.id)">
      <text class="node-name">{{ node.name }}</text>
    </view>

    <view v-if="instruments.length === 0" class="card">
      <text class="hint">还没有支付工具。先在「数据导入 / 节点」中添加。</text>
    </view>
  </scroll-view>
</template>

<script lang="uts">
import { getSecureDb } from '../../uni_modules/depmap-secure-database'

export default {
  data() {
    return {
      title: '',
      templateId: 'replace_payment_card',
      instruments: [] as Array<{ id: string, name: string }>
    }
  },
  onLoad(options: Map<string, string>) {
    this.templateId = options.get('templateId') ?? 'replace_payment_card'
    this.title = this.templateId === 'expiring_payment_card'
      ? '银行卡即将到期'
      : this.templateId === 'close_payment_instrument'
        ? '注销银行卡'
        : '更换银行卡'
  },
  onShow() {
    this.load()
  },
  methods: {
    load() {
      const db = getSecureDb()
      db.query("SELECT id, name FROM nodes WHERE kind = 'payment_instrument' ORDER BY name", []).then((rows) => {
        const list: Array<{ id: string, name: string }> = []
        for (let i = 0; i < rows.length; i++) {
          const row = rows[i] as Map<string, any | null>
          list.push({ id: String(row.get('id')), name: String(row.get('name')) })
        }
        this.instruments = list
      })
    },
    create(targetNodeId: string) {
      const db = getSecureDb()
      db.query("SELECT CAST(value AS INTEGER) AS c FROM meta WHERE key = 'graph_revision'", []).then((rows) => {
        const revision = rows.length > 0 ? Number((rows[0] as Map<string, any | null>).get('c') ?? 0) : 0
        const now = new Date().toISOString()
        db.exec(
          'INSERT INTO change_plans (id, template_id, scenario, title, workflow_state, baseline_graph_revision, last_analyzed_graph_revision, target_node_id, effective_date, params_json, impact_snapshot_json, action_items_json, created_at, updated_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)',
          [
            `plan-${now}`, this.templateId, this.templateId, `${this.title}`, 'draft',
            revision, revision, targetNodeId, null, '{}', null,
            JSON.stringify([
              { id: 'prepare-1', title: '检查依赖', detail: '确认哪些支付关系依赖此对象。', phase: 'prepare', done: false, doneAt: null, verification: null },
              { id: 'change-1', title: '迁移必要支付关系', detail: '把必须保留的支付关系迁移到新来源。', phase: 'change', done: false, doneAt: null,
                verification: { method: 'future_observation', status: 'pending', verifiedAt: null, evidenceRefs: [] } },
              { id: 'verify-1', title: '验证关键支付路径', detail: '变更后用真实支付证据确认。', phase: 'verify', done: false, doneAt: null,
                verification: { method: 'future_observation', status: 'pending', verifiedAt: null, evidenceRefs: [] } }
            ]),
            now, now
          ]
        ).then(() => {
          uni.redirectTo({ url: '/pages/plans/plans' })
        })
      })
    }
  }
}
</script>

<style>
.root {
  flex: 1;
}
.intro {
  margin: 10px;
}
.title {
  font-size: 18px;
  font-weight: bold;
}
.card {
  margin: 10px;
  padding: 14px;
  background-color: #ffffff;
  border-radius: 8px;
}
.node-name {
  font-size: 16px;
}
.hint {
  color: #86909c;
  font-size: 13px;
}
</style>
