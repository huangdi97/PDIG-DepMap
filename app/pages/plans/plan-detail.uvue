<template>
  <scroll-view class="page" scroll-y>
    <dp-card :title="detail.title">
      <view class="chip-row">
        <dp-chip :status="readiness" />
      </view>
      <text class="meta">分析版本 {{ detail.analyzed }} / 当前 {{ detail.current }}</text>
      <text class="meta">工作流状态：{{ workflowText }}</text>
    </dp-card>

    <dp-card v-if="detail.stale" title="需要重新检查">
      <text class="meta">基础设施在这个计划创建之后发生了变化。重新分析后，已完成的动作不会被改动。</text>
      <view class="gap" />
      <dp-button label="重新分析" :loading="busy" @tap="reanalyze" />
    </dp-card>

    <dp-card title="本次分析依据">
      <view class="chip-row">
        <dp-chip :status="coverage.level" :text="coverageText" />
      </view>
      <text class="expl" v-for="(e, i) in coverage.explanations" :key="'c' + i">· {{ e }}</text>
      <text class="quiet">最近一次导入：{{ lastIngestedText }}</text>
      <text class="quiet">依据等级只反映"我们了解多少"，不代表安全程度。</text>
    </dp-card>

    <dp-card title="影响">
      <dp-row title="必须处理" description="你确认过失去它会失效" :value="detail.mustChangeCount + ' 项'" value-tone="danger" />
      <dp-row title="需要确认" description="关系已确认，但"是否必须使用"未确认" :value="detail.needsReviewCount + ' 项'" value-tone="warning" :last="true" />
      <text class="quiet" v-if="detail.mustChangeCount === 0 && detail.needsReviewCount === 0">本次分析未发现受影响且已确认的支付关系。</text>
    </dp-card>

    <dp-card title="要做的事">
      <view class="act" v-for="a in detail.actions" :key="a.id">
        <view class="act-row" @click="toggle(a)">
          <text :class="a.done ? 'act-done' : 'act-todo'">{{ a.done ? '已完成' : '待完成' }}</text>
          <view class="act-body">
            <text :class="a.done ? 'act-title-done' : 'act-title'">{{ a.title }}</text>
            <text class="quiet">{{ phaseText(a.phase) }}</text>
          </view>
        </view>
        <view v-if="a.verificationStatus !== ''" class="verify">
          <text v-if="a.verificationStatus === 'verified'" class="verified">已验证</text>
          <view v-else class="verify-btn" @click="verify(a)">
            <text class="verify-text">{{ a.verificationStatus === 'evidence_suggested' ? '确认已生效（有新数据支持）' : '手动标记已验证' }}</text>
          </view>
        </view>
      </view>
      <text class="quiet">完成不等于验证。动作完成后，仍需要新的真实证据或你的手动确认。</text>
    </dp-card>

    <dp-card title="下一步">
      <dp-button :label="ctaLabel" :loading="busy" @tap="onCta" block />
      <text class="quiet">{{ ctaHint }}</text>
    </dp-card>

    <view class="foot" />
  </scroll-view>
</template>

<script lang="uts">
import { getPlanDetail, setActionDone, verifyAction, reanalyzePlan, getPlanCoverage } from '../../services/depmap-service'
import { computeReadiness, coverageLabel, workflowLabel } from '../../services/rules'

interface ActionRow {
  id: string
  title: string
  phase: string
  done: boolean
  resolvesImpactKeys: string[]
  verificationStatus: string
  verificationMethod: string
}

interface PlanRow {
  id: string
  title: string
  workflowState: string
  stale: boolean
  analyzed: number
  current: number
  targetNodeId: string
  mustChangeCount: number
  needsReviewCount: number
  pendingMustChange: number
  pendingReview: number
  actions: ActionRow[]
  rawActionsJson: string
}

interface CoverageRow {
  level: string
  explanations: string[]
  sourceCount: number
  freshSourceCount: number
  confirmedDirect: number
  pendingProposals: number
  unresolvedCandidates: number
  unknownCriticality: number
  lastIngestedAt: string
}

export default {
  data() {
    return {
      planId: '',
      busy: false,
      detail: {
        id: '',
        title: '',
        workflowState: 'draft',
        stale: false,
        analyzed: 0,
        current: 0,
        targetNodeId: '',
        mustChangeCount: 0,
        needsReviewCount: 0,
        pendingMustChange: 0,
        pendingReview: 0,
        actions: [] as ActionRow[],
        rawActionsJson: '[]'
      } as PlanRow,
      coverage: {
        level: 'unknown',
        explanations: [] as string[],
        sourceCount: 0,
        freshSourceCount: 0,
        confirmedDirect: 0,
        pendingProposals: 0,
        unresolvedCandidates: 0,
        unknownCriticality: 0,
        lastIngestedAt: ''
      } as CoverageRow
    }
  },
  computed: {
    readiness(): string {
      return computeReadiness({
        pendingMustChange: this.detail.pendingMustChange,
        pendingReview: this.detail.pendingReview,
        stale: this.detail.stale
      })
    },
    workflowText(): string {
      return workflowLabel(this.detail.workflowState)
    },
    coverageText(): string {
      return coverageLabel(this.coverage.level)
    },
    lastIngestedText(): string {
      if (this.coverage.sourceCount === 0) return '还没有导入任何数据来源'
      return this.coverage.lastIngestedAt === '' ? '未知' : this.coverage.lastIngestedAt.slice(0, 10)
    },
    ctaLabel(): string {
      if (this.readiness === 'blocked') return '处理必须事项'
      if (this.detail.stale) return '重新分析'
      if (this.readiness === 'review_required') return '继续确认'
      if (this.detail.workflowState === 'completed') return '查看结果'
      return '继续下一步'
    },
    ctaHint(): string {
      if (this.readiness === 'blocked') return '上面还有必须处理的支付关系，处理完才能继续。'
      if (this.detail.stale) return '基础设施已变化，先重新分析再继续。'
      if (this.readiness === 'review_required') return '还有信息需要确认。'
      return '基于当前已知并确认的信息，可以继续下一步。'
    }
  },
  onLoad(options: Map<string, string>) {
    this.planId = options.get('id') ?? ''
  },
  onShow() {
    this.load()
  },
  methods: {
    phaseText(phase: string): string {
      if (phase === 'prepare') return '准备'
      if (phase === 'change') return '执行变更'
      if (phase === 'verify') return '验证'
      return '步骤'
    },
    load() {
      getPlanDetail(this.planId).then((d) => {
        if (d === null) return
        const row = d as PlanRow
        this.detail = row
        // Coverage 以「变更目标节点」为口径（此前误传 planId，导致口径恒为空）
        getPlanCoverage(row.targetNodeId, 45).then((c) => {
          this.coverage = c as CoverageRow
        })
      })
    },
    toggle(a: ActionRow) {
      this.busy = true
      setActionDone(this.planId, a.id, !a.done)
        .then((d) => {
          if (d !== null) this.detail = d as PlanRow
          this.busy = false
        })
        .catch((_e) => {
          this.busy = false
          uni.showToast({ title: '保存失败，请重试', icon: 'none' })
        })
    },
    verify(a: ActionRow) {
      this.busy = true
      verifyAction(this.planId, a.id)
        .then((d) => {
          if (d !== null) this.detail = d as PlanRow
          this.busy = false
        })
        .catch((_e) => {
          this.busy = false
          uni.showToast({ title: '保存失败，请重试', icon: 'none' })
        })
    },
    reanalyze() {
      this.busy = true
      reanalyzePlan(this.planId)
        .then((d) => {
          if (d !== null) this.detail = d as PlanRow
          this.busy = false
          uni.showToast({ title: '已重新分析', icon: 'none' })
        })
        .catch((_e) => {
          this.busy = false
          uni.showToast({ title: '重新分析失败', icon: 'none' })
        })
    },
    onCta() {
      if (this.readiness === 'blocked' || this.readiness === 'review_required') {
        uni.showToast({ title: '请先处理上面的事项', icon: 'none' })
        return
      }
      if (this.detail.stale) {
        this.reanalyze()
        return
      }
      uni.showToast({ title: '可以继续下一步', icon: 'none' })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.chip-row { flex-direction: row; margin-bottom: 8px; }
.meta { margin-top: 4px; font-size: 13px; color: #5A5F73; }
.expl { margin-top: 4px; font-size: 13px; color: #5A5F73; }
.quiet { margin-top: 6px; font-size: 13px; color: #8A90A6; }
.gap { height: 8px; }
.act { margin-bottom: 10px; }
.act-row { flex-direction: row; min-height: 44px; align-items: center; }
.act-body { flex: 1; margin-left: 8px; }
.act-todo { font-size: 13px; color: #B9BDCC; }
.act-done { font-size: 13px; color: #2BA471; }
.act-title { font-size: 15px; color: #1B1D29; }
.act-title-done { font-size: 15px; color: #8A90A6; }
.verify { margin-top: 4px; }
.verified { font-size: 13px; color: #2BA471; }
.verify-btn {
  min-height: 44px;
  padding: 0 12px;
  background-color: #F0F1F5;
  border-radius: 10px;
  align-items: center;
  justify-content: center;
  flex-direction: row;
}
.verify-text { font-size: 13px; color: #4C4FD8; }
.foot { height: 24px; }
</style>
