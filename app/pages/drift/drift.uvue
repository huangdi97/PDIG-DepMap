<template>
  <scroll-view class="page" scroll-y>
    <dp-card title="可能发生了变化">
      <text class="lead">只有观察到新的正向证据（而不是「没看到」）才会出现在这里。</text>
      <dp-state
        v-if="loading"
        kind="loading"
        title="正在读取…"
      />
      <dp-state
        v-else-if="errorText !== ''"
        kind="error"
        title="读取失败"
        :description="errorText"
        action-label="重试"
        @action="load"
      />
      <dp-state
        v-else-if="drifts.length === 0"
        kind="empty"
        title="当前没有待确认的变化"
        description="你的已确认关系与最近观察到的数据一致。"
      />
    </dp-card>

    <dp-card v-for="d in drifts" :key="d.id" :title="driftTitle(d.kind)">
      <text class="line">当前已确认：{{ confirmedText }}</text>
      <text class="line">最近观察到：{{ observedText(d) }}</text>
      <view class="opt" @click="resolve(d.id, 'replacement')">
        <text class="opt-text">已经换成新来源</text>
      </view>
      <view class="opt" @click="resolve(d.id, 'additional')">
        <text class="opt-text">两个都在使用</text>
      </view>
      <view class="opt" @click="dismiss(d.id)">
        <text class="opt-text">没有变化</text>
      </view>
      <view class="opt" @click="later(d.id)">
        <text class="opt-text">稍后确认</text>
      </view>
      <text class="quiet">「已经换成新来源」会确认新来源并停用旧路径；「两个都在使用」只确认新来源。</text>
    </dp-card>
  </scroll-view>
</template>

<script lang="uts">
import { listDrifts, resolveDrift, dismissDrift } from '../../services/depmap-service'

interface DriftRow {
  id: string
  kind: string
  observations: number
  detectedAt: string
}

export default {
  data() {
    return {
      loading: true,
      errorText: '',
      confirmedText: '你此前确认的支付路径',
      drifts: [] as DriftRow[]
    }
  },
  onShow() {
    this.load()
  },
  methods: {
    driftTitle(kind: string): string {
      if (kind === 'possible_replacement') return '可能换了支付来源'
      if (kind === 'possible_additional_path') return '可能新增了一条支付路径'
      return '可能发生了变化'
    },
    observedText(d: DriftRow): string {
      return `在最近的数据里出现了 ${d.observations} 次`
    },
    load() {
      this.loading = true
      this.errorText = ''
      listDrifts()
        .then((rows) => {
          this.drifts = rows as DriftRow[]
          this.loading = false
        })
        .catch((_e) => {
          this.loading = false
          this.errorText = '本地数据暂时无法读取。'
        })
    },
    resolve(id: string, mode: string) {
      resolveDrift(id, mode)
        .then(() => this.load())
        .catch((_e) => {
          uni.showToast({ title: '保存失败，请重试', icon: 'none' })
        })
    },
    dismiss(id: string) {
      dismissDrift(id)
        .then(() => this.load())
        .catch((_e) => {
          uni.showToast({ title: '保存失败，请重试', icon: 'none' })
        })
    },
    later(_id: string) {
      uni.showToast({ title: '已保留，稍后可再处理', icon: 'none' })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.lead {
  font-size: 13px;
  color: #8A90A6;
}
.line {
  margin-top: 4px;
  font-size: 14px;
  color: #5A5F73;
}
.opt {
  margin-top: 8px;
  min-height: 44px;
  padding: 0 12px;
  background-color: #F0F1F5;
  border-radius: 10px;
  align-items: center;
  justify-content: center;
  flex-direction: row;
}
.opt-text {
  font-size: 15px;
  color: #4C4FD8;
}
.quiet {
  margin-top: 8px;
  font-size: 13px;
  color: #8A90A6;
}
</style>
