<template>
  <scroll-view class="page" scroll-y>
    <dp-card title="即将到来">
      <dp-state
        v-if="loading"
        kind="loading"
        title="正在整理…"
      />
      <dp-state
        v-else-if="errorText !== ''"
        kind="error"
        title="读取失败"
        :description="errorText"
        action-label="重试"
        @action="load"
      />
      <dp-state
        v-else-if="items.length === 0"
        kind="empty"
        title="近期没有需要处理的数字基础设施事项"
        description="卡片到期、计划时间点、来源刷新都会出现在这里。"
      />
      <view v-else>
        <dp-row
          v-for="(item, i) in items"
          :key="item.id"
          :title="item.title"
          :description="item.subtitle + ' · ' + bucketLabel(item.bucket)"
          :value="dateText(item)"
          :last="i === items.length - 1"
          @tap="open(item)"
        />
      </view>
    </dp-card>
  </scroll-view>
</template>

<script lang="uts">
import { getTimeline } from '../../services/depmap-service'
import { timelineBucketLabel } from '../../services/rules'

interface TimelineRow {
  id: string
  title: string
  subtitle: string
  scheduledAt: string
  bucket: string
  sourceType: string
  sourceId: string
}

export default {
  data() {
    return {
      loading: true,
      errorText: '',
      items: [] as TimelineRow[]
    }
  },
  onShow() {
    this.load()
  },
  methods: {
    bucketLabel(bucket: string): string {
      return timelineBucketLabel(bucket)
    },
    dateText(item: TimelineRow): string {
      if (item.scheduledAt === '') return ''
      return item.scheduledAt.slice(0, 10)
    },
    load() {
      this.loading = true
      this.errorText = ''
      getTimeline()
        .then((rows) => {
          this.items = rows as TimelineRow[]
          this.loading = false
        })
        .catch((_e) => {
          this.loading = false
          this.errorText = '本地数据暂时无法读取。'
        })
    },
    open(item: TimelineRow) {
      if (item.sourceType === 'change_plan') {
        uni.navigateTo({ url: `/pages/plans/plan-detail?id=${item.sourceId}` })
      } else if (item.sourceType === 'reality_drift') {
        uni.navigateTo({ url: '/pages/drift/drift' })
      } else if (item.sourceType === 'source_freshness') {
        uni.navigateTo({ url: '/pages/sources/sources' })
      } else if (item.sourceType === 'node_expiry') {
        uni.navigateTo({ url: `/pages/nodes/node-detail?id=${item.sourceId}` })
      }
    }
  }
}
</script>

<style>
.page { flex: 1; }
</style>
