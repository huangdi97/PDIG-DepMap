<template>
  <scroll-view class="root" scroll-y>
    <view class="card" v-for="(item, index) in items" :key="index" @click="open(item)">
      <text class="item-title">{{ item.title }}</text>
      <text class="hint">{{ item.subtitle }}</text>
      <view class="row">
        <text :class="'bucket-' + item.bucket">{{ bucketLabel(item.bucket) }}</text>
        <text class="hint" v-if="item.scheduledAt !== ''">{{ item.scheduledAt.slice(0, 10) }}</text>
      </view>
    </view>
    <view v-if="items.length === 0" class="card">
      <text class="hint">当前没有与数字基础设施相关的待办与临近事项。</text>
    </view>
  </scroll-view>
</template>

<script lang="uts">
import { getSecureDb } from '../../uni_modules/depmap-secure-database'

interface TimelineRow {
  id: string
  kind: string
  title: string
  subtitle: string
  scheduledAt: string
  bucket: string
  sourceType: string
  sourceId: string
}

// bucket 次序与 core buildTimeline 一致：attention → overdue → today → 7d → 30d → 90d → later
const BUCKET_ORDER = ['attention', 'overdue', 'today', '7d', '30d', '90d', 'later']

export default {
  data() {
    return {
      items: [] as TimelineRow[]
    }
  },
  onShow() {
    this.load()
  },
  methods: {
    bucketLabel(bucket: string): string {
      if (bucket === 'attention') return '需要你处理'
      if (bucket === 'overdue') return '已逾期'
      if (bucket === 'today') return '今天'
      if (bucket === '7d') return '7 天内'
      if (bucket === '30d') return '30 天内'
      if (bucket === '90d') return '90 天内'
      return '以后'
    },
    rank(bucket: string): number {
      const idx = BUCKET_ORDER.indexOf(bucket)
      return idx < 0 ? 99 : idx
    },
    bucketOf(scheduledAt: string): string {
      if (scheduledAt === '') return 'attention'
      const t = Date.parse(scheduledAt)
      if (Number.isNaN(t)) return 'attention'
      const now = new Date()
      const startOfToday = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()))
      const day = 86400000
      const base = startOfToday.getTime()
      if (t < base) return 'overdue'
      if (t < base + day) return 'today'
      if (t < base + 8 * day) return '7d'
      if (t < base + 31 * day) return '30d'
      if (t < base + 91 * day) return '90d'
      return 'later'
    },
    load() {
      const db = getSecureDb()
      const items: TimelineRow[] = []
      // 1. 计划：stale → attention；effective_date → upcoming
      db.query(
        "SELECT p.id, p.title, p.workflow_state, p.effective_date, p.last_analyzed_graph_revision AS analyzed, (SELECT CAST(value AS INTEGER) FROM meta WHERE key = 'graph_revision') AS current FROM change_plans p",
        []
      ).then((rows) => {
        for (let i = 0; i < rows.length; i++) {
          const row = rows[i] as Map<string, any | null>
          const state = String(row.get('workflow_state'))
          if (state === 'completed' || state === 'cancelled') continue
          const analyzed = Number(row.get('analyzed') ?? 0)
          const current = Number(row.get('current') ?? 0)
          const title = String(row.get('title'))
          const id = String(row.get('id'))
          if (current > analyzed) {
            items.push({ id: `tl-plan-stale-${id}`, kind: 'needs_attention', title: `计划需要重新检查：${title}`,
              subtitle: '基础设施在此计划创建后发生了变化。', scheduledAt: '', bucket: 'attention',
              sourceType: 'change_plan', sourceId: id })
          } else {
            const eff = row.get('effective_date') === null ? '' : String(row.get('effective_date'))
            items.push({ id: `tl-plan-${id}`, kind: 'upcoming_change', title,
              subtitle: `变更计划（${state}）`, scheduledAt: eff, bucket: this.bucketOf(eff),
              sourceType: 'change_plan', sourceId: id })
          }
        }
        // 2. open drifts → attention
        db.query("SELECT id, kind, target_node_id, detected_at FROM reality_drifts WHERE status = 'open'", []).then((rows2) => {
          for (let i = 0; i < rows2.length; i++) {
            const row = rows2[i] as Map<string, any | null>
            items.push({ id: `tl-drift-${String(row.get('id'))}`, kind: 'drift_review', title: '可能发生了变化',
              subtitle: `${String(row.get('kind'))}（需确认或忽略）`, scheduledAt: String(row.get('detected_at') ?? ''),
              bucket: 'attention', sourceType: 'reality_drift', sourceId: String(row.get('id')) })
          }
          // 3. 即将到期的卡 → expiration
          db.query("SELECT id, name, fields_json FROM nodes WHERE kind = 'payment_instrument' AND fields_json LIKE '%expiryDate%'", []).then((rows3) => {
            for (let i = 0; i < rows3.length; i++) {
              const row = rows3[i] as Map<string, any | null>
              const fields = String(row.get('fields_json') ?? '')
              const idx = fields.indexOf('expiryDate')
              if (idx < 0) continue
              const expiry = fields.substring(idx + 13, idx + 23)
              items.push({ id: `tl-expiry-${String(row.get('id'))}`, kind: 'expiration',
                title: `${String(row.get('name'))} 即将到期`, subtitle: '检查仍依赖此对象的支付路径。',
                scheduledAt: expiry, bucket: this.bucketOf(expiry), sourceType: 'node_expiry', sourceId: String(row.get('id')) })
            }
            // 4. stale 来源 → attention（freshness）
            db.query("SELECT id, label FROM source_instances WHERE state = 'active' AND (last_ingested_at IS NULL OR last_ingested_at < ?)", [
              new Date(Date.now() - 45 * 86400000).toISOString()
            ]).then((rows4) => {
              for (let i = 0; i < rows4.length; i++) {
                const row = rows4[i] as Map<string, any | null>
                items.push({ id: `tl-fresh-${String(row.get('id'))}`, kind: 'freshness_review',
                  title: `数据来源需要刷新：${String(row.get('label'))}`, subtitle: '超过 45 天未导入。',
                  scheduledAt: '', bucket: 'attention', sourceType: 'source_freshness', sourceId: String(row.get('id')) })
              }
              // deterministic 排序：bucket 次序 → scheduledAt → id
              items.sort((a, b) => {
                const ra = this.rank(a.bucket)
                const rb = this.rank(b.bucket)
                if (ra !== rb) return ra - rb
                if (a.scheduledAt !== b.scheduledAt) return a.scheduledAt < b.scheduledAt ? -1 : 1
                return a.id < b.id ? -1 : 1
              })
              this.items = items
            })
          })
        })
      })
    },
    open(item: TimelineRow) {
      if (item.sourceType === 'change_plan') {
        uni.navigateTo({ url: `/pages/plans/plan-detail?id=${item.sourceId}` })
      } else if (item.sourceType === 'reality_drift') {
        uni.navigateTo({ url: '/pages/drift/drift' })
      }
    }
  }
}
</script>

<style>
.root {
  flex: 1;
}
.card {
  margin: 10px;
  padding: 12px;
  background-color: #ffffff;
  border-radius: 8px;
}
.item-title {
  font-size: 15px;
  font-weight: bold;
}
.row {
  margin-top: 6px;
  flex-direction: row;
  justify-content: space-between;
}
.bucket-attention {
  color: #f53f3f;
}
.bucket-overdue {
  color: #f53f3f;
}
.bucket-today {
  color: #d48806;
}
.bucket-7d {
  color: #d48806;
}
.bucket-30d {
  color: #165dff;
}
.bucket-90d {
  color: #165dff;
}
.bucket-later {
  color: #86909c;
}
.hint {
  color: #86909c;
  font-size: 13px;
}
</style>
