<template>
  <scroll-view class="page" scroll-y>
    <view class="hero">
      <text class="hero-title">今天有需要你处理的事吗</text>
      <text class="hero-sub">换卡、换号、注销账户之前，先看清会影响哪些服务。</text>
    </view>

    <dp-card title="需要你处理">
      <dp-state
        v-if="loading"
        kind="loading"
        title="正在读取本地数据…"
      />
      <dp-state
        v-else-if="errorText !== ''"
        kind="error"
        title="读取失败"
        :description="errorText"
        action-label="重试"
        @action="load"
      />
      <view v-else-if="todoTotal === 0">
        <text class="quiet">还没有需要处理的事项。</text>
        <text class="quiet-sub">先把你常用的卡、账户和服务添加进来，再声明它们之间的支付关系。</text>
        <view class="gap" />
        <dp-button label="添加第一个对象" variant="secondary" @tap="go('/pages/nodes/nodes')" block />
      </view>
      <view v-else>
        <dp-row
          v-if="s.pendingProposals > 0"
          title="待确认关系"
          description="机器推断出的支付关系，需要你确认或拒绝"
          :value="s.pendingProposals + ' 条'"
          value-tone="warning"
          @tap="go('/pages/proposals/proposals')"
        />
        <dp-row
          v-if="s.openDrifts > 0"
          title="可能发生了变化"
          description="观察到新的正向证据"
          :value="s.openDrifts + ' 项'"
          value-tone="warning"
          @tap="go('/pages/drift/drift')"
        />
        <dp-row
          v-if="s.unresolvedCandidates > 0"
          title="待确认服务"
          description="发现可能属于你的服务"
          :value="s.unresolvedCandidates + ' 个'"
          value-tone="warning"
          @tap="go('/pages/candidates/candidates')"
        />
        <dp-row
          v-if="s.stalePlans > 0"
          title="计划需要重新检查"
          description="基础设施在此计划创建后发生了变化"
          :value="s.stalePlans + ' 个'"
          value-tone="warning"
          @tap="go('/pages/plans/plans')"
          :last="true"
        />
      </view>
    </dp-card>

    <dp-card title="即将到来">
      <dp-row
        v-if="s.upcomingText !== ''"
        :title="s.upcomingText"
        description="查看还有哪些支付关系依赖它"
        value="查看"
        @tap="go('/pages/timeline/timeline')"
        :last="true"
      />
      <text v-else class="quiet">近期没有需要处理的数字基础设施事项。</text>
    </dp-card>

    <dp-card title="常用场景">
      <dp-row
        v-for="(sc, i) in scenarios"
        :key="sc.id"
        :title="sc.title"
        :description="sc.description"
        @tap="startScenario(sc.id)"
        :last="i === scenarios.length - 1"
      />
    </dp-card>

    <dp-card title="我的基础设施">
      <dp-row
        title="支付 · 账户 · 服务"
        :description="'已确认依赖 ' + s.confirmedDependencies + ' 条'"
        @tap="go('/pages/nodes/nodes')"
      />
      <dp-row title="影响模拟" description="假设某张卡不能用了" @tap="go('/pages/simulate/simulate')" />
      <dp-row title="数据导入" description="微信账单 / CSV / OFX" value="暂未开放" value-tone="warning" @tap="go('/pages/import/import-wechat')" />
      <dp-row title="数据来源" description="管理已导入的来源" @tap="go('/pages/sources/sources')" />
      <dp-row title="备份与恢复" :description="'加密备份 · 最近导出：' + backupText" @tap="go('/pages/backup/backup')" />
      <dp-row title="设置与隐私" @tap="go('/pages/settings/settings')" :last="true" />
    </dp-card>

    <dp-card title="当前版本说明">
      <text class="p">已支持：手动建立支付关系、影响模拟、变更计划、时间轴与验证记录。</text>
      <text class="p">账单导入与加密备份的文件处理模块仍在接入中，因此这两项目前不会写入或覆盖任何数据。</text>
    </dp-card>

    <view class="foot">
      <text class="quiet-sub">数据默认在本机处理 · 无账号 · 无云端同步</text>
    </view>
  </scroll-view>
</template>

<script lang="uts">
import { getHomeSummary } from '../../services/depmap-service'
import { executableScenarios } from '../../services/rules'

interface Summary {
  pendingProposals: number
  openDrifts: number
  stalePlans: number
  pendingVerifications: number
  unresolvedCandidates: number
  upcomingText: string
  lastExportAt: string
  confirmedDependencies: number
}

interface Scenario {
  id: string
  title: string
  description: string
  recommendedLeadDays: number
}

export default {
  data() {
    return {
      loading: true,
      errorText: '',
      backupText: '从未导出',
      scenarios: executableScenarios() as Scenario[],
      s: {
        pendingProposals: 0,
        openDrifts: 0,
        stalePlans: 0,
        pendingVerifications: 0,
        unresolvedCandidates: 0,
        upcomingText: '',
        lastExportAt: '',
        confirmedDependencies: 0
      } as Summary
    }
  },
  computed: {
    todoTotal(): number {
      return this.s.pendingProposals + this.s.openDrifts + this.s.stalePlans + this.s.unresolvedCandidates
    }
  },
  onShow() {
    this.load()
  },
  methods: {
    load() {
      this.loading = true
      this.errorText = ''
      getHomeSummary()
        .then((summary) => {
          this.s = summary as Summary
          this.backupText = summary.lastExportAt === '' ? '从未导出' : summary.lastExportAt.slice(0, 10)
          this.loading = false
        })
        .catch((_e) => {
          this.loading = false
          this.errorText = '本地数据暂时无法读取。请重试；若持续失败，请到「备份与恢复」检查数据文件。'
        })
    },
    go(url: string) {
      uni.navigateTo({ url })
    },
    startScenario(id: string) {
      uni.navigateTo({ url: `/pages/plans/plan-create?templateId=${id}` })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.hero {
  padding: 20px 16px 4px 16px;
}
.hero-title {
  font-size: 22px;
  font-weight: bold;
  color: #1B1D29;
}
.hero-sub {
  margin-top: 6px;
  font-size: 13px;
  color: #8A90A6;
}
.quiet {
  font-size: 15px;
  color: #5A5F73;
}
.quiet-sub {
  margin-top: 4px;
  font-size: 13px;
  color: #8A90A6;
}
.p {
  margin-top: 4px;
  font-size: 14px;
  color: #5A5F73;
}
.gap { height: 8px; }
.foot {
  padding: 4px 16px 24px 16px;
  align-items: center;
}
</style>
