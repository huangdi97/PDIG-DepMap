<template>
  <scroll-view class="page" scroll-y>
    <view class="intro">
      <text class="intro-title">场景中心</text>
      <text class="intro-sub">从一个实际变化开始。这里只包含与数字基础设施相关的场景。</text>
    </view>

    <dp-card title="推荐">
      <dp-state
        v-if="scenarios.length === 0"
        kind="empty"
        title="暂无可执行场景"
        description="当前版本只提供已实现支付能力的场景。"
      />
      <view v-else>
        <view class="scenario" v-for="sc in scenarios" :key="sc.id">
          <dp-row
            :title="sc.title"
            :description="sc.description"
            :value="sc.recommendedLeadDays > 0 ? '建议提前 ' + sc.recommendedLeadDays + ' 天' : ''"
            :last="true"
            @tap="start(sc.id)"
          />
          <view class="start" @click="start(sc.id)">
            <text class="start-text">开始</text>
          </view>
        </view>
      </view>
    </dp-card>

    <view class="foot">
      <text class="quiet-sub">日常提醒（生日、喝水、会议）不属于本产品范围。</text>
    </view>
  </scroll-view>
</template>

<script lang="uts">
import { executableScenarios } from '../../services/rules'

interface Scenario {
  id: string
  title: string
  description: string
  recommendedLeadDays: number
}

export default {
  data() {
    return {
      scenarios: executableScenarios() as Scenario[]
    }
  },
  methods: {
    start(templateId: string) {
      uni.navigateTo({ url: `/pages/plans/plan-create?templateId=${templateId}` })
    }
  }
}
</script>

