<template>
  <scroll-view class="root" scroll-y>
    <view class="intro">
      <text class="hint">场景模板只包含与数字基础设施相关的事件（支付 / 账户 / 身份 / 设备）。日常生活提醒不属于 PDIG。</text>
    </view>

    <view class="card" v-for="(tpl, index) in templates" :key="index">
      <text class="tpl-title">{{ tpl.title }}</text>
