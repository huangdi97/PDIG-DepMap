<template>
  <scroll-view class="page" scroll-y>
    <dp-card title="备用路径确认">
      <text class="lead">检测到同一目标有多条支付来源。只有你确认"会自动切换"，系统才会在影响分析里认为存在备用路径。</text>
      <dp-state
        v-if="loading"
        kind="loading"
        title="正在读取…"
      />
      <dp-state
        v-else-if="groupProposals.length === 0"
        kind="empty"
        title="暂无待确认的备用路径"
      />
    </dp-card>

    <dp-card v-for="g in groupProposals" :key="g.key" :title="g.title">
      <text class="quiet">组合方式：{{ modeText(g.mode) }}</text>
      <view class="row">
        <view class="cell">
          <dp-button label="确认会切换" :loading="busy" @tap="accept(g.key)" />
        </view>
        <view class="cell">
          <dp-button label="不会" variant="secondary" :loading="busy" @tap="reject(g.key)" />
        </view>
      </view>
    </dp-card>
  </scroll-view>
</template>

<script lang="uts">
import { listGroupProposals, acceptGroupProposal, rejectGroupProposal } from '../../services/depmap-service'

interface GroupRow {
  key: string
  title: string
  mode: string
}

export default {
  data() {
    return {
      loading: true,
      busy: false,
      groupProposals: [] as GroupRow[]
    }
  },
  onShow() {
    this.load()
  },
  methods: {
    modeText(mode: string): string {
      if (mode === 'ANY') return '任意一个可用即可'
      return '必须全部可用'
    },
    load() {
      this.loading = true
      listGroupProposals()
        .then((rows) => {
          this.groupProposals = rows as GroupRow[]
          this.loading = false
        })
        .catch((_e) => {
          this.loading = false
        })
    },
    accept(key: string) {
      this.busy = true
      acceptGroupProposal(key)
        .then(() => {
          this.busy = false
          uni.showToast({ title: '已确认', icon: 'none' })
          this.load()
        })
        .catch((_e) => {
          this.busy = false
          uni.showToast({ title: '保存失败，请重试', icon: 'none' })
        })
    },
    reject(key: string) {
      this.busy = true
      rejectGroupProposal(key)
        .then(() => {
          this.busy = false
          this.load()
        })
        .catch((_e) => {
          this.busy = false
          uni.showToast({ title: '保存失败，请重试', icon: 'none' })
        })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.lead { font-size: 13px; color: #8A90A6; }
.quiet { font-size: 13px; color: #8A90A6; }
.row { flex-direction: row; margin-top: 12px; }
.cell { flex: 1; margin-right: 8px; }
</style>
