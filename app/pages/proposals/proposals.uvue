<template>
  <scroll-view class="page" scroll-y>
    <dp-card title="待确认关系">
      <text class="lead">机器推断不等于现实。只有你确认，才会写入依赖图。</text>
      <dp-state
        v-if="loading"
        kind="loading"
        title="正在读取…"
      />
      <dp-state
        v-else-if="errorText !== ''"
        kind="error"
        title="读取失败"
        :description="errorText"
        action-label="重试"
        @action="load"
      />
      <dp-state
        v-else-if="proposals.length === 0"
        kind="empty"
        title="暂时没有待确认关系"
        description="导入新的账单后，这里会出现需要你确认的支付关系。"
      />
    </dp-card>

    <dp-card v-for="p in proposals" :key="p.key" :title="relationLabel(p.relation)">
      <text class="line">{{ p.title }}</text>
      <text class="quiet">累计观测 {{ p.observationCount }} 次</text>
      <view class="row">
        <view class="cell">
          <dp-button label="是" variant="primary" :loading="busy" @tap="accept(p.key)" />
        </view>
        <view class="cell">
          <dp-button label="不是" variant="secondary" :loading="busy" @tap="reject(p.key)" />
        </view>
      </view>
      <text class="quiet">确认后按「需要确认」记录；只有你明确知道失去它支付会失效，才应标为必须使用。</text>
    </dp-card>
  </scroll-view>
</template>

<script lang="uts">
import { listProposals, acceptProposal, rejectProposal } from '../../services/depmap-service'
import { relationLabel } from '../../services/rules'

interface ProposalRow {
  key: string
  title: string
  relation: string
  observationCount: number
}

export default {
  data() {
    return {
      loading: true,
      errorText: '',
      busy: false,
      proposals: [] as ProposalRow[]
    }
  },
  onShow() {
    this.load()
  },
  methods: {
    relationLabel(relation: string): string {
      return relationLabel(relation)
    },
    load() {
      this.loading = true
      this.errorText = ''
      listProposals()
        .then((rows) => {
          this.proposals = rows as ProposalRow[]
          this.loading = false
        })
        .catch((_e) => {
          this.loading = false
          this.errorText = '本地数据暂时无法读取。'
        })
    },
    accept(key: string) {
      this.busy = true
      acceptProposal(key, 'unknown')
        .then(() => {
          this.busy = false
          uni.showToast({ title: '已确认', icon: 'none' })
          this.load()
        })
        .catch((_e) => {
          this.busy = false
          uni.showToast({ title: '保存失败，请重试', icon: 'none' })
        })
    },
    reject(key: string) {
      this.busy = true
      rejectProposal(key)
        .then(() => {
          this.busy = false
          uni.showToast({ title: '已拒绝（有新的证据才可能再次出现）', icon: 'none' })
          this.load()
        })
        .catch((_e) => {
          this.busy = false
          uni.showToast({ title: '保存失败，请重试', icon: 'none' })
        })
    }
  }
}
</script>

<style>
.page { flex: 1; }
.lead { font-size: 13px; color: #8A90A6; }
.line { font-size: 15px; color: #1B1D29; }
.quiet { margin-top: 6px; font-size: 13px; color: #8A90A6; }
.row { flex-direction: row; margin-top: 12px; }
.cell { flex: 1; margin-right: 8px; }
</style>
