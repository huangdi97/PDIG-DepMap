<template>
  <view class="root">
    <text class="app-title">个人数字依赖图</text>
    <text class="app-sub">换卡之前，先看清影响</text>

    <dp-state
      v-if="errorText !== ''"
      kind="error"
      title="无法打开本地数据"
      :description="errorText"
      action-label="重试"
      @action="unlock"
    />

    <view v-else class="btn-wrap">
      <dp-button :label="busy ? '正在验证…' : '使用生物识别 / 设备密码解锁'" :loading="busy" @tap="unlock" block />
    </view>

    <text class="quiet">本地加密存储 · 无账号 · 无云端同步</text>
  </view>
</template>

<script lang="uts">
import { authenticate } from '../../uni_modules/depmap-biometric'
import { openAndMigrate } from '../../services/depmap-service'
import { appState } from '../../stores/app-state'

export default {
  data() {
    return {
      busy: false,
      errorText: ''
    }
  },
  methods: {
    unlock() {
      if (this.busy) return
      this.busy = true
      this.errorText = ''
      authenticate('解锁个人数字依赖图')
        .then((res) => {
          if (!res.ok) {
            this.busy = false
            uni.showToast({ title: '未通过验证，无法进入', icon: 'none' })
            return
          }
          openAndMigrate()
            .then((_version) => {
              this.busy = false
              appState.unlocked = true
              uni.reLaunch({ url: '/pages/home/home' })
            })
            .catch((_e) => {
              this.busy = false
              this.errorText = '数据文件暂时无法打开。你的数据没有被修改，可以重试；若持续失败，请从备份恢复。'
            })
        })
        .catch((_e) => {
          this.busy = false
          uni.showToast({ title: '验证被取消', icon: 'none' })
        })
    }
  }
}
</script>

<style>
.root {
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 32px;
}
.app-title {
  font-size: 26px;
  font-weight: bold;
  color: #1B1D29;
}
.app-sub {
  margin-top: 8px;
  font-size: 15px;
  color: #8A90A6;
}
.btn-wrap {
  margin-top: 48px;
  width: 280px;
}
.quiet {
  margin-top: 24px;
  font-size: 13px;
  color: #8A90A6;
}
</style>
