/**
 * 应用状态（内存，非持久化）—— 三端共享业务逻辑通过 UTS 插件调用平台安全层。
 * 注意：所有真实数据访问走 depmap-secure-database 插件；本文件只持有
 * 会话级状态与页面间传递参数。
 */

export interface ProposalItem {
  key: string
  title: string
  detail: string
  confidence: number
  observationCount: number
}

export interface ChecklistItem {
  level: string // must_change | backup_path | degraded | needs_review | unaffected | target_operation
  title: string
  detail: string
}

export interface PendingMerchant {
  merchantRaw: string
  observationCount: number
  paymentMethods: string[]
}

export const appState = reactive({
  unlocked: false,
  /** 当前导入会话的 pending 商户（Node Resolution 页面使用） */
  pendingMerchants: [] as PendingMerchant[],
  /** 影响清单结果（simulate → impact-result 传递） */
  checklist: [] as ChecklistItem[],
  scenarioTitle: ''
})
