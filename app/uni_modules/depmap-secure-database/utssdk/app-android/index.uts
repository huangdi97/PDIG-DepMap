/**
 * depmap-secure-database — Android 实现（UTS → Kotlin）。
 * 桥接 platforms/android 下的 SqlCipherSecureDatabaseAdapter。
 * 状态：源码完成（IMPLEMENTED）。COMPILED = NO（需 HBuilderX 自定义基座，见 BLOCKERS.md）。
 */
import { SqlCipherSecureDatabaseAdapter } from 'com.depmap.core.security.SqlCipherSecureDatabaseAdapter'
import { KeystoreSecureKeyAdapter } from 'com.depmap.core.security.KeystoreSecureKeyAdapter'
import { SecureDatabaseOpenOptions } from 'com.depmap.core.security.SecureDatabaseOpenOptions'

export type SqlRow = Map<string, any | null>

export class SecureDbAndroid implements SecureDb {
  private adapter: SqlCipherSecureDatabaseAdapter

  constructor() {
    const keyAdapter = new KeystoreSecureKeyAdapter(UTSAndroid.getAppContext()!)
    this.adapter = new SqlCipherSecureDatabaseAdapter(UTSAndroid.getAppContext()!, keyAdapter)
  }

  open(dbName: string): Promise<void> {
    return new Promise((resolve, reject) => {
      this.adapter.open(new SecureDatabaseOpenOptions(dbName),
        () => resolve(),
        (err: string) => reject(new Error(err)))
    })
  }

  close(): Promise<void> {
    return new Promise((resolve) => {
      this.adapter.close()
      resolve()
    })
  }

  migrate(): Promise<number> {
    return new Promise((resolve, reject) => {
      this.adapter.migrate(
        (version: number) => resolve(version),
        (err: string) => reject(new Error(err))
      )
    })
  }

  query(sql: string, params: Array<any | null>): Promise<Array<SqlRow>> {
    return new Promise((resolve, reject) => {
      this.adapter.query(sql, params,
        (rows: Array<Map<string, any | null>>) => resolve(rows),
        (err: string) => reject(new Error(err)))
    })
  }

  execute(sql: string, params: Array<any | null>): Promise<number> {
    return new Promise((resolve, reject) => {
      this.adapter.execute(sql, params,
        (changes: number) => resolve(changes),
        (err: string) => reject(new Error(err)))
    })
  }

  transaction<T>(fn: () => Promise<T>): Promise<T> {
    return new Promise((resolve, reject) => {
      this.adapter.transaction({
        run: (): Promise<T> => fn(),
        onSuccess: (v: T) => resolve(v),
        onError: (err: string) => reject(new Error(err))
      })
    })
  }
}

let instance: SecureDbAndroid | null = null

export function getSecureDb(): SecureDb {
  if (instance == null) {
    instance = new SecureDbAndroid()
  }
  return instance!
}
