/**
 * depmap-secure-database — Android 实现（UTS → Kotlin）。
 * 桥接 platforms/android 下的 SqlCipherSecureDatabaseAdapter。
 *
 * 2026-09-15 修复 R-3（见 `PRODUCTION_RUNTIME_UI_AUDIT.md`）：
 * 原实现对 `SqlCipherSecureDatabaseAdapter` 的 suspend 方法按「回调式」签名调用
 * （例如 `open(options, onSuccess, onError)`），而 Kotlin 侧真实签名是
 * `suspend fun open(options: SecureDatabaseOpenOptions)`（`:36`）——
 * **参数个数都不匹配**。`migrate/query/execute/transaction` 同理（`:50` / `:71` / `:93` / `:114`）。
 * 另外 suspend 方法在 JVM 上还会多出一个 `Continuation` 参数，UTS 侧更无从表达。
 *
 * 现改经 `UtsSecurityBridge`（Kotlin 侧新增的回调式桥接，已由 Gradle 真实编译验证）调用；
 * 桥接层签名与此处原本期望的 onSuccess / onError 风格保持一致。
 *
 * 状态：源码完成（IMPLEMENTED）。COMPILED = NO（需 HBuilderX 自定义基座，见 BLOCKERS.md B10）。
 */
import { SqlCipherSecureDatabaseAdapter } from 'com.depmap.core.security.SqlCipherSecureDatabaseAdapter'
import { UtsSecurityBridge } from 'com.depmap.core.security.UtsSecurityBridge'

export type SqlRow = Map<string, any | null>

export class SecureDbAndroid implements SecureDb {
  private adapter: SqlCipherSecureDatabaseAdapter

  constructor() {
    this.adapter = UtsSecurityBridge.createSecureDatabase(
      UTSAndroid.getAppContext()!,
      UtsSecurityBridge.createSecureKeyAdapter(UTSAndroid.getAppContext()!)
    )
  }

  open(dbName: string): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      UtsSecurityBridge.dbOpen(this.adapter, dbName,
        () => {
          resolve()
        },
        (err: string) => {
          reject(new Error(err))
        })
    })
  }

  close(): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      UtsSecurityBridge.dbClose(this.adapter,
        () => {
          resolve()
        },
        (err: string) => {
          reject(new Error(err))
        })
    })
  }

  migrate(): Promise<number> {
    return new Promise<number>((resolve, reject) => {
      UtsSecurityBridge.dbMigrate(this.adapter,
        (version: number) => {
          resolve(version)
        },
        (err: string) => {
          reject(new Error(err))
        })
    })
  }

  query(sql: string, params: Array<any | null>): Promise<Array<SqlRow>> {
    return new Promise<Array<SqlRow>>((resolve, reject) => {
      UtsSecurityBridge.dbQuery(this.adapter, sql, params,
        (rows: Array<Map<string, any | null>>) => {
          resolve(rows)
        },
        (err: string) => {
          reject(new Error(err))
        })
    })
  }

  execute(sql: string, params: Array<any | null>): Promise<number> {
    return new Promise<number>((resolve, reject) => {
      UtsSecurityBridge.dbExecute(this.adapter, sql, params,
        (changes: number) => {
          resolve(changes)
        },
        (err: string) => {
          reject(new Error(err))
        })
    })
  }

  /**
   * 事务。
   *
   * 桥接层把事务体收敛为**同步执行**（`UtsSecurityBridge.dbTransaction` 的 `body`），
   * 因此**事务体内不能依赖前一条 SQL 的回调结果**。当前 App 侧事务仅用于
   * 「Reality mutation 与 revision +1 同事务」，均为串行写且不读回，满足该约束。
   */
  transaction<T>(fn: () => Promise<T>): Promise<T> {
    return new Promise<T>((resolve, reject) => {
      let value: T | null = null
      UtsSecurityBridge.dbTransaction(
        this.adapter,
        () => {
          fn().then((v: T) => {
            value = v
          })
        },
        () => {
          resolve(value as T)
        },
        (err: string) => {
          reject(new Error(err))
        })
    })
  }
}

let instance: SecureDbAndroid | null = null

export function getSecureDb(): SecureDb {
  if (instance == null) {
    instance = new SecureDbAndroid()
  }
  return instance!
}
