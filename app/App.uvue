<script lang="uts">
import { setPrivacyScreen } from './uni_modules/depmap-privacy-screen'

const PRIVACY_KEY = 'dp_privacy_screen'

export default {
  onLaunch: function () {
    // 启动：不做任何网络请求、不写业务数据。
    // 数据库打开与迁移在 unlock 页经应用服务层完成。
    // 隐私屏（截图保护）为用户设置，默认开启，在此恢复上次选择。
    const stored = uni.getStorageSync(PRIVACY_KEY) as string
    setPrivacyScreen(stored === '0' ? false : true)
  },
  onShow: function () {
    // 切回前台：隐私遮罩由 PrivacyScreenAdapter 处理
  },
  onHide: function () {
    // 切后台：iOS 遮罩 / Android FLAG_SECURE 由插件接管
  }
}
</script>

<style>
/* 全局基础样式（颜色与 app/theme/tokens.uts 保持一致） */
page {
  background-color: #F5F6FA;
  font-size: 15px;
  color: #1B1D29;
}
</style>
