  "adapters": [
    {
      "id": "wechat_statement",
      "version": 1,
      "sourceKind": "statement_file",
      "coverageMode": "event_stream",
      "authoritativeFor": [],
      "parserId": "wechat_statement",
      "parserVersion": 1
    },
    {
      "id": "generic_csv",
      "version": 1,
      "sourceKind": "statement_file",
