{
  "$comment": "PDIG Canonical Domain Spec — SINGLE SOURCE OF TRUTH. Three native platforms (Kotlin/Swift/ArkTS) MUST NOT redefine any value here. Extraction oracle: core/ @ commit 7bc0ed3 (see LEGACY_REFERENCE_MANIFEST.md). Regenerate platform enums with `node tools/codegen/generate.mjs`; hand-editing generated files fails the codegen gate.",
  "specVersion": "1.0.0",
  "appSchemaVersion": 3,

  "graphPayload": {
    "kind": "depmap-logical-graph",
    "version": 3,
    "migratableFrom": [1, 2],
    "failureMode": "fail_closed"
  },

  "enums": {
    "NodeKind": {
      "values": [
        "identity_anchor",
        "payment_instrument",
        "account",
        "service",
        "membership",
        "device",
        "custom"
      ],
      "storageAll": true,
      "note": "Runtime MVP creation set is narrower than this enum; see runtimeCreatableNodeKinds in constants."
    },

    "Relation": {
      "values": [
        "funding_source",
        "merchant_agreement",
        "verifies",
        "recovers",
        "bound_to",
        "authenticates",
        "controls"
      ],
      "runtimeValues": [
        "funding_source",
        "merchant_agreement",
        "recovers",
        "authenticates",
        "controls"
      ],
      "note": "DB CHECK constraint accepts all 7; RelationDefinitionRegistry validates only runtimeValues. verifies/bound_to remain storage-legacy/future and MUST be rejected by runtime validation on all three platforms. recovers/authenticates/controls enter the runtime registry in v0.3.0 (Canonical vNext)."
    },

    "Capability": {
      "values": ["payment", "access", "authentication", "recovery", "communication", "identity"],
      "runtimeValues": ["payment", "access", "authentication", "recovery", "communication"],
      "note": "v0.3.0 Impact kernel propagates all five runtime capabilities via (nodeId, capability) state keys. identity is storage-allowed but NOT a runtime propagation capability."
    },

    "Criticality": {
      "values": ["required", "unknown"],
      "machineMaySetRequired": false
    },

    "DependencyState": { "values": ["active", "retired"] },
    "DependencyOrigin": { "values": ["manual", "proposal"] },
    "GroupMode": { "values": ["ANY", "ALL"] },
    "GroupState": { "values": ["active", "retired"] },
    "ProposalDecision": { "values": ["pending", "accepted", "rejected"] },

    "VerificationBasisType": {
      "values": ["user_confirmed", "authoritative_source"],
      "mvpRuntimeValues": ["user_confirmed"],
      "note": "All three MVP file adapters are event_stream, so every Reality fact in MVP02/03 is user_confirmed."
    },

    "SourceKind": {
      "values": ["statement_file", "platform_export", "open_banking", "manual", "discovery"]
    },

    "CoverageMode": {
      "values": ["event_stream", "partial_snapshot", "complete_snapshot", "user_selected"],
      "mvpRuntimeValues": ["event_stream"],
      "note": "absence semantics: only non-event_stream modes could ever support negative inference. MVP has none."
    },

    "SourceInstanceState": { "values": ["active", "retired"] },

    "ObservationDirection": { "values": ["in", "out", "neutral"] },

    "EvidenceKind": { "values": ["transaction_stream"] },

    "ProposalType": { "values": ["recurring_payment_route"] },

    "ProposalSource": { "values": ["statement"] },

    "ImpactLevel": {
      "values": [
        "must_change",
        "backup_path",
        "degraded",
        "needs_review",
        "unaffected",
        "target_operation"
      ],
      "note": "target_operation is emitted only as the final checklist item; it never appears as a target status."
    },

    "ImpactTargetStatus": {
      "values": ["must_change", "backup_path", "degraded", "needs_review", "unaffected"],
      "severityOrder": ["unaffected", "needs_review", "backup_path", "degraded", "must_change"],
      "note": "severity ranking used for state merge: must_change(3) > backup_path|degraded(2) > needs_review(1) > unaffected(0)."
    },

    "ImpactReasonCode": {
      "values": [
        "required_edge_no_alternative",
        "confirmed_group_failed",
        "confirmed_group_covered",
        "unconfirmed_alternative_exists",
        "criticality_unknown",
        "proposal_only",
        "upstream_uncertain"
      ]
    },

    "ChangePlanWorkflowState": {
      "values": [
        "draft",
        "analyzed",
        "review_required",
        "ready",
        "in_progress",
        "verifying",
        "completed",
        "cancelled"
      ],
      "terminalValues": ["completed", "cancelled"]
    },

    "PlanEffectiveStatus": {
      "values": [
        "draft",
        "analyzed",
        "review_required",
        "ready",
        "in_progress",
        "verifying",
        "completed",
        "cancelled",
        "needs_revalidation"
      ],
      "derivedOnly": ["needs_revalidation"],
      "note": "needs_revalidation is DERIVED, never persisted; stored workflowState is never rewritten by staleness."
    },

    "PlanActionPhase": { "values": ["prepare", "change", "verify"] },

    "ActionVerificationMethod": {
      "values": ["manual_confirmation", "future_observation", "authoritative_source"]
    },

    "ActionVerificationStatus": {
      "values": ["not_required", "pending", "evidence_suggested", "verified", "failed"],
      "nonOverridableByEvidence": ["verified", "failed", "not_required"]
    },

    "PlanReadiness": {
      "values": ["blocked", "review_required", "ready_with_known_scope"],
      "forbiddenSynonyms": ["safe", "fully_safe", "all_clear", "100%"],
      "note": "Exactly three values. No confidence channel, no absence channel exists in the input type."
    },

    "CoverageLevel": {
      "values": ["unknown", "limited", "partial", "well_evidenced"],
      "note": "Information coverage description, NOT a safety score."
    },

    "DriftKind": {
      "values": ["possible_replacement", "possible_additional_path", "relation_reappeared"]
    },

    "DriftStatus": {
      "values": ["open", "confirmed_change", "dismissed", "superseded"],
      "actionableValues": ["open"]
    },

    "DriftIgnoreReason": { "values": ["already_confirmed", "below_threshold"] },

    "CandidateKind": { "values": ["payment_instrument", "service"] },

    "CandidateStatus": {
      "values": ["pending", "accepted", "dismissed", "superseded"],
      "actionableValues": ["pending"]
    },

    "TimelineBucket": {
      "values": ["attention", "overdue", "today", "7d", "30d", "90d", "later"],
      "sortOrder": ["attention", "overdue", "today", "7d", "30d", "90d", "later"]
    },

    "TimelineItemKind": {
      "values": [
        "needs_attention",
        "upcoming_change",
        "verification_pending",
        "freshness_review",
        "drift_review",
        "expiration"
      ]
    },

    "TimelineSourceType": {
      "values": [
        "change_plan",
        "reality_drift",
        "action_verification",
        "node_expiry",
        "source_freshness"
      ]
    },

    "ScenarioCategory": {
      "values": ["payment", "identity", "device", "work", "international", "digital_assets"]
    },

    "ScenarioAvailability": { "values": ["active", "planned"] },

    "AmountSignMode": { "values": ["signed", "debit_credit", "outward_positive"] },

    "CsvDelimiter": { "values": [",", ";", "\t", "|"] },

    "SourceEncoding": { "values": ["utf-8", "gb18030"] },

    "FailureDomainKind": {
      "values": [
        "DEVICE",
        "PHONE_NUMBER",
        "ACCOUNT",
        "PROVIDER",
        "PERSON",
        "REGION",
        "PHYSICAL_LOCATION",
        "NETWORK"
      ],
      "runtimeValues": ["DEVICE", "PHONE_NUMBER", "ACCOUNT", "PROVIDER"],
      "note": "v0.3.0 production FailureDomain kinds are DEVICE/PHONE_NUMBER/ACCOUNT/PROVIDER. PERSON/REGION/PHYSICAL_LOCATION/NETWORK are spec vocabulary for future rounds; runtime must not create them."
    },

    "FailureDomainStatus": {
      "values": ["confirmed", "needs_review"],
      "note": "A shared failure domain is only 'confirmed' when backed by confirmed reality; machine inference may at most produce needs_review."
    },

    "InfrastructureFindingType": {
      "values": [
        "SINGLE_POINT_OF_FAILURE",
        "SHARED_FAILURE_DOMAIN",
        "RECOVERY_CYCLE",
        "UNCONFIRMED_FALLBACK",
        "STALE_RECOVERY_INFORMATION",
        "UNKNOWN_CRITICAL_PATH",
        "PENDING_VERIFICATION"
      ],
      "note": "v0.3.0 exactly these seven finding kinds, each with what/why/confirmed basis/unknowns/affected capability/recommended next action/evidence refs. No pseudo-precision scores."
    },

    "ChangePrimitive": {
      "values": ["REPLACE", "LOSE", "COMPROMISE", "MIGRATE", "PORT", "SUSPEND"],
      "runtimeValues": ["REPLACE"],
      "note": "v0.3.0 active primitive is REPLACE only (replace_payment_card, replace_phone_number). Remaining values are registered vocabulary for future rounds and MUST NOT be executable."
    },

    "RecoveryCycleStatus": {
      "values": ["confirmed_cycle", "potential_cycle", "no_cycle"],
      "note": "Only confirmed-reality active edges can produce confirmed_cycle; proposal/candidate edges at most produce potential_cycle."
    },

    "PathIndependenceStatus": {
      "values": ["verified_independent", "shared_failure_domain", "needs_review"],
      "note": "Classification of a recovery/authentication path pair. NEVER exposed as a numeric health score to users."
    },

    "ActionDagViolation": {
      "values": ["cycle", "missing_prerequisite", "unknown_action", "none"],
      "note": "Action DAG validation verdict. 'cycle' and 'missing_prerequisite' are rejected at plan build time; a stable deterministic topological order is emitted otherwise."
    },

    "ProviderPolicyState": {
      "values": ["effective", "superseded", "needs_review"],
      "note": "A ProviderPolicy whose current rule cannot be proven against an official/verifiable source MUST be needs_review, never silently treated as eternal truth."
    },

    "TemporalChangePhase": { "values": ["before", "transition", "after"] },

    "MakeBeforeBreakStatus": { "values": ["blocked", "allowed"] }
  },

  "entities": {
    "Node": {
      "logicalKey": ["id"],
      "unique": [["id"]],
      "fields": {
        "id": "string",
        "kind": "NodeKind",
        "templateId": "string|null",
        "name": "string",
        "issuer": "string|null",
        "last4": "string|null",
        "owner": "string",
        "archived": "boolean",
        "fields": "object",
        "vaultRef": "string|null",
        "walletRef": "string|null",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "realityClass": "confirmed_reality",
      "bumpsGraphRevisionOn": ["create", "update", "archive"]
    },

    "Dependency": {
      "logicalKey": ["from", "relation", "to", "capability"],
      "logicalKeySerialization": "from|relation|to|capability",
      "unique": [["from", "relation", "to", "capability"]],
      "enforcedBy": "database_unique_constraint",
      "fields": {
        "id": "string",
        "from": "nodeId",
        "relation": "Relation",
        "to": "nodeId",
        "capability": "Capability",
        "criticality": "Criticality",
        "groupId": "string|null",
        "state": "DependencyState",
        "origin": "DependencyOrigin",
        "confirmedAt": "timestamp",
        "lastVerifiedAt": "timestamp",
        "retiredAt": "timestamp|null",
        "evidenceRefs": "string[]",
        "verificationBasis": "VerificationBasis|null",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "realityClass": "confirmed_reality",
      "lifecycle": {
        "firstObservationOfLogicalKey": "INSERT",
        "alreadyActive": "UPSERT_AND_VERIFY",
        "afterRetireReappears": "REACTIVATE_SAME_ROW",
        "forbidden": "creating a second row for the same logical key"
      },
      "bumpsGraphRevisionOn": ["confirm_create", "confirm_update", "retire", "reactivate"]
    },

    "DependencyGroup": {
      "logicalKey": ["groupKey"],
      "groupKeySerialization": "targetNodeId|capability|mode|sorted(memberLogicalKeys...)",
      "fields": {
        "id": "string",
        "groupKey": "string",
        "targetNodeId": "nodeId",
        "capability": "Capability",
        "mode": "GroupMode",
        "memberEdgeIds": "string[]",
        "state": "GroupState",
        "confirmedAt": "timestamp",
        "lastVerifiedAt": "timestamp",
        "verificationBasis": "VerificationBasis|null",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "realityClass": "confirmed_reality",
      "invariant": "memberLogicalKeys are sorted and de-duplicated before hashing into groupKey; member order is therefore irrelevant."
    },

    "DependencyProposal": {
      "logicalKey": ["key"],
      "fields": {
        "id": "string",
        "key": "string",
        "from": "nodeId",
        "relation": "Relation",
        "to": "nodeId",
        "capability": "Capability",
        "proposalType": "ProposalType",
        "source": "ProposalSource",
        "parserId": "string",
        "parserVersion": "integer",
        "confidenceScore": "number",
        "path": "string[]",
        "evidenceRefs": "string[]",
        "decision": "ProposalDecision",
        "decidedAt": "timestamp|null",
        "criticalityDecision": "Criticality|null",
        "observationCount": "integer",
        "rejectedAt": "timestamp|null",
        "rejectedAtStreamCounts": "map<sourceInstanceId,integer>|null",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "realityClass": "proposal",
      "bumpsGraphRevision": false,
      "note": "confidenceScore is display-only. It MUST NOT influence must_change or readiness on any platform."
    },

    "DependencyGroupProposal": {
      "logicalKey": ["key"],
      "keySerialization": "group|<canonicalGroupKey(target,capability,mode,sortedMemberKeys...)>",
      "realityClass": "proposal",
      "bumpsGraphRevision": false
    },

    "Evidence": {
      "logicalKey": ["proposalKey", "sourceInstanceId"],
      "unique": [["proposalKey", "sourceInstanceId"]],
      "realityClass": "evidence_summary",
      "bumpsGraphRevision": false,
      "note": "Per-stream summary. observationCount MUST NOT be summed across streams to drive any decision."
    },

    "ObservationFingerprint": {
      "logicalKey": ["sourceInstanceId", "fingerprintVersion", "fingerprint"],
      "unique": [["sourceInstanceId", "fingerprintVersion", "fingerprint"]],
      "realityClass": "evidence_summary",
      "note": "Fingerprint namespace is scoped by SourceInstance. Different SourceInstances must never share a fingerprint namespace."
    },

    "ImportSession": {
      "logicalKey": ["id"],
      "realityClass": "audit_summary",
      "bumpsGraphRevision": false
    },

    "SourceInstance": {
      "logicalKey": ["id"],
      "realityClass": "configuration",
      "bumpsGraphRevision": false
    },

    "ChangePlan": {
      "logicalKey": ["id"],
      "realityClass": "user_intent_snapshot",
      "bumpsGraphRevision": false,
      "note": "A ChangePlan is NOT Reality. It records a user-acknowledged intent plus an impact snapshot."
    },

    "RealityDrift": {
      "logicalKey": ["id"],
      "realityClass": "proposal",
      "bumpsGraphRevisionOn": ["create_never"],
      "note": "Creating a drift never mutates Reality and never bumps the revision."
    },

    "DiscoveryCandidate": {
      "logicalKey": ["normalizedKey"],
      "unique": [["normalizedKey"]],
      "realityClass": "candidate",
      "bumpsGraphRevision": false,
      "note": "A candidate does not participate in Impact and does not bump the revision. Only accept creates a Node."
    },

    "GraphRevision": {
      "storage": "meta table key 'graph_revision', initial 0",
      "realityClass": "reality_version_clock",
      "bumpsOn": "confirmed Reality mutation only",
      "atomicity": "reality mutation + revision increment in the SAME transaction"
    },

    "$commentV030": "Entities below are added by Canonical vNext (v0.3.0). They extend — never replace — the entities above. Old 91 fixtures remain byte-identical; new capabilities add new fixtures only.",

    "FailureDomain": {
      "logicalKey": ["id"],
      "realityClass": "confirmed_reality_when_confirmed",
      "fields": {
        "id": "string",
        "kind": "FailureDomainKind",
        "subjectRef": "nodeId",
        "scope": "string",
        "evidenceRefs": "string[]",
        "status": "FailureDomainStatus",
        "confirmedAt": "timestamp|null",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "note": "FailureDomain itself obeys the reality boundary: only user confirmation or authoritative evidence yields status=confirmed; machine inference may at most create needs_review."
    },

    "InfrastructureFinding": {
      "logicalKey": ["id"],
      "realityClass": "derived_projection",
      "fields": {
        "id": "string",
        "type": "InfrastructureFindingType",
        "what": "string",
        "why": "string",
        "confirmedBasis": "string",
        "unknowns": "string",
        "affectedCapability": "Capability",
        "recommendedNextAction": "string",
        "evidenceRefs": "string[]",
        "createdAt": "timestamp"
      },
      "bumpsGraphRevision": false,
      "note": "InfrastructureFindings are derived projections of confirmed reality. They never mutate Reality and never bump graphRevision. No pseudo-precision scores."
    },

    "ChangePrimitiveRef": {
      "logicalKey": ["id"],
      "fields": {
        "id": "string",
        "primitive": "ChangePrimitive",
        "subjectKind": "string",
        "subjectSubtype": "string|null",
        "note": "replace_payment_card = REPLACE x payment_instrument; replace_phone_number = REPLACE x identity_anchor(phone_number)."
      },
      "realityClass": "vocabulary"
    },

    "ProviderPolicy": {
      "logicalKey": ["provider", "policyType", "policyRevision"],
      "fields": {
        "provider": "string",
        "policyType": "string",
        "sourceUrl": "string",
        "retrievedAt": "timestamp",
        "lastVerifiedAt": "timestamp|null",
        "effectiveFrom": "timestamp|null",
        "effectiveTo": "timestamp|null",
        "jurisdiction": "string|null",
        "accountTypeScope": "string|null",
        "parameters": "object",
        "policyRevision": "integer",
        "state": "ProviderPolicyState"
      },
      "realityClass": "knowledge_plane",
      "bumpsGraphRevision": false,
      "invariant": "Provider supports X != User has configured X. ProviderPolicy may influence interpretation/suggestion/revalidation but must never auto-create dependencies, auto-confirm phone numbers, or auto-mark required."
    },

    "RecoveryCycle": {
      "logicalKey": ["id"],
      "realityClass": "derived_projection",
      "fields": {
        "id": "string",
        "status": "RecoveryCycleStatus",
        "path": "string[]",
        "capability": "Capability",
        "confirmedBasis": "string",
        "detectedAt": "timestamp"
      },
      "bumpsGraphRevision": false,
      "note": "Only confirmed-reality active edges can produce confirmed_cycle; proposal/candidate edges at most produce potential_cycle."
    }
  },

  "relations": {
    "funding_source": {
      "fromKinds": ["payment_instrument", "account", "service", "membership"],
      "toKinds": ["account", "payment_instrument"],
      "capability": "payment",
      "allowsGroup": true,
      "allowedGroupModes": ["ANY"],
      "defaultCriticality": "unknown",
      "verificationPolicy": "user_only",
      "impactSemantics": "dependency"
    },
    "merchant_agreement": {
      "fromKinds": ["account", "payment_instrument"],
      "toKinds": ["service", "membership", "account"],
      "capability": "payment",
      "allowsGroup": false,
      "allowedGroupModes": [],
      "defaultCriticality": "unknown",
      "verificationPolicy": "user_only",
      "impactSemantics": "dependency"
    },

    "recovers": {
      "fromKinds": ["identity_anchor", "account", "device", "service"],
      "toKinds": ["account", "service", "identity_anchor"],
      "capability": "recovery",
      "allowsGroup": true,
      "allowedGroupModes": ["ANY"],
      "defaultCriticality": "unknown",
      "verificationPolicy": "user_only",
      "impactSemantics": "dependency",
      "note": "v0.3.0 production relation. Recovery-capability dependency edge (e.g. SMS recovery from a phone number anchor)."
    },

    "authenticates": {
      "fromKinds": ["identity_anchor", "account", "device"],
      "toKinds": ["account", "service"],
      "capability": "authentication",
      "allowsGroup": true,
      "allowedGroupModes": ["ANY"],
      "defaultCriticality": "unknown",
      "verificationPolicy": "user_only",
      "impactSemantics": "dependency",
      "note": "v0.3.0 production relation. Authentication-capability dependency edge (e.g. passkey or password manager authenticates an account)."
    },

    "controls": {
      "fromKinds": ["account", "device"],
      "toKinds": ["account", "service", "identity_anchor"],
      "capability": "access",
      "allowsGroup": false,
      "allowedGroupModes": [],
      "defaultCriticality": "unknown",
      "verificationPolicy": "user_only",
      "impactSemantics": "dependency",
      "note": "v0.3.0 production relation. Access-capability dependency edge (e.g. device controls sign-in of an account)."
    }
  },

  "futureRelations": {
    "$comment": "Spec-only. MUST NOT be enabled in the runtime registry during native migration.",
    "values": ["card_on_file", "direct_debit_mandate", "payout_destination", "wallet_funding"],
    "availability": "backlog"
  },

