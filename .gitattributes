# 源码文本统一 LF，避免 Windows CRLF 污染
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Parser fixtures 按原始字节处理（含 GB18030 fixture，禁止归一化）
core/tests/fixtures/* -text

# 二进制
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# 平台源码按文本 LF
*.kt text eol=lf
*.kts text eol=lf
*.swift text eol=lf
*.ets text eol=lf
*.uvue text eol=lf
*.uts text eol=lf
*.json5 text eol=lf
