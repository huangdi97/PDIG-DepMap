  "{\n  \"id\": \"jcs-rfc8785-restricted-domain\",\n  \"category\": \"jcs\",\n  \"specVersion\": \"1.0.0\",\n  \"appSchemaVersion\": 3,\n  \"oracle\": \"core (TypeScript reference) @ LEGACY_REFERENCE_MANIFEST.md\",\n  \"description\": \"RFC 8785 JCS（受限值域）：对象键排序、转义、整数最短形式；浮点必须拒绝而非静默序列化\",\n  \"input\": {\n    \"cases\": [\n      {\n        \"id\": \"key-order\",\n        \"input\": {\n          \"b\": 1,\n          \"a\": 2\n        }\n      },\n      {\n        \"id\": \"nested\",\n        \"input\": {\n          \"z\": {\n            \"b\": true,\n            \"a\": false\n          },\n          \"a\": [\n            1,\n            2\n          ]\n        }\n      },\n      {\n        \"id\": \"escape\",\n        \"input\": {\n          \"k\": \"a\\\"b\\\\c\\nd\"\n        }\n      },\n      {\n        \"id\": \"control-char\",\n        \"input\": {\n          \"k\": \"\\u0001\"\n        }\n      },\n      {\n        \"id\": \"empty-object\",\n        \"input\": {}\n      },\n      {\n        \"id\": \"unicode-pass-through\",\n        \"input\": {\n          \"k\": \"银行\"\n        }\n      },\n      {\n        \"id\": \"numbers\",\n        \"input\": {\n          \"i\": 0,\n          \"j\": 1234567890\n        }\n      },\n      {\n        \"id\": \"null-bool\",\n        \"input\": {\n          \"n\": null,\n          \"t\": true,\n          \"f\": false\n        }\n      },\n      {\n        \"id\": \"array-strings\",\n        \"input\": [\n          \"a\",\n          \"b\"\n        ]\n      }\n    ],\n    \"rejectCases\": [\n      {\n        \"id\": \"float\",\n        \"input\": {\n          \"f\": 1.5\n        }\n      }\n    ]\n  },\n  \"expected\": {\n    \"canonical\": {\n      \"key-order\": \"{\\\"a\\\":2,\\\"b\\\":1}\",\n      \"nested\": \"{\\\"a\\\":[1,2],\\\"z\\\":{\\\"a\\\":false,\\\"b\\\":true}}\",\n      \"escape\": \"{\\\"k\\\":\\\"a\\\\\\\"b\\\\\\\\c\\\\nd\\\"}\",\n      \"control-char\": \"{\\\"k\\\":\\\"\\\\u0001\\\"}\",\n      \"empty-object\": \"{}\",\n      \"unicode-pass-through\": \"{\\\"k\\\":\\\"银行\\\"}\",\n      \"numbers\": \"{\\\"i\\\":0,\\\"j\\\":1234567890}\",\n      \"null-bool\": \"{\\\"f\\\":false,\\\"n\\\":null,\\\"t\\\":true}\",\n      \"array-strings\": \"[\\\"a\\\",\\\"b\\\"]\"\n    },\n    \"rejections\": {\n      \"float\": \"Error\"\n    }\n  }\n}\n",
