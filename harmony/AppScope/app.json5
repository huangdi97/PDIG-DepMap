{
  "app": {
    // bundleName 需与正式包名对齐；当前为占位，正式包名仍受 Store 侧 blocker 约束。
    "bundleName": "com.pdig.depmap",
    "vendor": "pdig",
    "versionCode": 1000000,
    "versionName": "1.0.0",
    "icon": "$media:app_icon",
    "label": "$string:app_name",
    "minAPIVersion": 12,
    "targetAPIVersion": 13
  }
}
