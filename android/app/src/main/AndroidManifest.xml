<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PDIG 权限最小化（spec §153）：只有导入账单/备份文件需要读取用户显式选择的文件。
         无 INTERNET：产品无业务网络、无 analytics、无 telemetry（spec §130）。

         P1-E 审计补充（2026-09-16）：
           - usesCleartextTraffic 显式声明 false。targetSdk>=28 时默认值本来就是 false，
             但默认值不出现在合并后的 Manifest 里，审计时无法"看到"这个决定，故显式写出。
           - 应用没有 INTERNET 权限，因此这条只是纵深防御，不是可用性开关。 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
        android:name=".PdigApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PDIG"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PDIG"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
